# Cadena de conexión MySQL (equivalente a conexion.php)
DATABASE_URL="mysql://root:@localhost:3306/registro_pacientes"

# Puerto del servidor Express
PORT=3000

# Clave secreta para firmar las cookies de sesión (usar un valor largo y aleatorio en producción)
SESSION_SECRET="cambia-esta-clave-por-una-aleatoria-y-larga"

# "production" activa cookies seguras (requiere HTTPS)
NODE_ENV=development
